htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration
.env

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
.vscode/

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# exclude data from source control by default
/component_seg/data/

# Arduino dataset (custom photos — kept on local disk / Drive only)
/component_seg/dataset/
/component_seg/dataset_png/
/component_seg/dataset_cropped/

# Board CAD files (Altium/EAGLE design files from Arduino docs — large, re-downloadable)
/component_seg/PCBfiles/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Claude Code working state
.claude/

# Training logs
/component_seg/logs/*.log

# Model checkpoints downloaded from Colab (super_resolution.h5 in
# component_seg/checkpoints/ is already tracked; this only catches the
# top-level .h5 backups)
/component_seg/best_*.h5

# Data archives at repo root
/component_seg/*.zip
/*.zip
